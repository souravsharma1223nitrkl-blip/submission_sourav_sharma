    <light name="Warehouse_CeilingLight_003" type="point">
      <pose frame="">0 0 9 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-4.70385 10.895 16.2659 -0 0.921795 -1.12701</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ROS 2 services to move models (used by moving_obstacles.py):
         /gazebo/set_entity_state, /gazebo/get_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <!-- ================= OUR ADDITIONS (everything above is the AWS world) =================
         The AWS floor surface is at z = 0.0342, so every addition stands at that height. -->

    <!-- Mezzanine (platform + ramp + railings). Its origin is where the ramp meets the
         platform; the platform reaches the east wall, the ramp points west. -->
    <include>
      <name>heavy_storage_mezzanine</name>
      <uri>model://amr_mezzanine</uri>
      <pose>4.40 1.965 0.0342 0 0 0</pose>
    </include>

    <!-- Crossover (4 cm floor bridge, 5 % ramps) across the west corridor, between the west rack
         and the ClutteringA block. Rotated 90 deg so you drive over it along y. -->
    <include>
      <name>west_corridor_crossover</name>
      <uri>model://amr_crossover</uri>
      <pose>-3.60 5.20 0.0342 0 0 1.5708</pose>
    </include>

    <!-- Pallets on the bottom level of the 6 east racks: 2 bays per rack.
         x = 3.775 / 5.70 (between the uprights), y = the rack's y from the AWS models above -->
    <include><name>pallet_E1_a</name><uri>model://amr_pallet</uri><pose>3.775  0.58 0.0342 0 0 0</pose></include>
    <include><name>pallet_E1_b</name><uri>model://amr_pallet</uri><pose>5.700  0.58 0.0342 0 0 0</pose></include>
    <include><name>pallet_D1_a</name><uri>model://amr_pallet</uri><pose>3.775 -1.24 0.0342 0 0 0</pose></include>
    <include><name>pallet_D1_b</name><uri>model://amr_pallet</uri><pose>5.700 -1.24 0.0342 0 0 0</pose></include>
    <include><name>pallet_D2_a</name><uri>model://amr_pallet</uri><pose>3.775 -3.04 0.0342 0 0 0</pose></include>
    <include><name>pallet_D2_b</name><uri>model://amr_pallet</uri><pose>5.700 -3.04 0.0342 0 0 0</pose></include>
    <include><name>pallet_E2_a</name><uri>model://amr_pallet</uri><pose>3.775 -4.83 0.0342 0 0 0</pose></include>
    <include><name>pallet_E2_b</name><uri>model://amr_pallet</uri><pose>5.700 -4.83 0.0342 0 0 0</pose></include>
    <include><name>pallet_D3_a</name><uri>model://amr_pallet</uri><pose>3.775 -6.75 0.0342 0 0 0</pose></include>
    <include><name>pallet_D3_b</name><uri>model://amr_pallet</uri><pose>5.700 -6.75 0.0342 0 0 0</pose></include>
    <include><name>pallet_E3_a</name><uri>model://amr_pallet</uri><pose>3.775 -8.67 0.0342 0 0 0</pose></include>
    <include><name>pallet_E3_b</name><uri>model://amr_pallet</uri><pose>5.700 -8.67 0.0342 0 0 0</pose></include>

    <!-- Pallet rows in the 4 bays of the long west rack (ShelfF) -->
    <include><name>pallet_row_F1</name><uri>model://amr_pallet_row</uri><pose>-5.79 -7.670 0.0342 0 0 0</pose></include>
    <include><name>pallet_row_F2</name><uri>model://amr_pallet_row</uri><pose>-5.79 -3.250 0.0342 0 0 0</pose></include>
    <include><name>pallet_row_F3</name><uri>model://amr_pallet_row</uri><pose>-5.79  1.185 0.0342 0 0 0</pose></include>
    <include><name>pallet_row_F4</name><uri>model://amr_pallet_row</uri><pose>-5.79  5.715 0.0342 0 0 0</pose></include>

    <!-- Moving obstacles (start positions; moving_obstacles.py moves them) -->
    <include><name>ped_hall</name>  <uri>model://amr_pedestrian</uri><pose>-1.50 -3.35 0.0342 0 0 0</pose></include>
    <include><name>ped_bays</name>  <uri>model://amr_pedestrian</uri><pose> 1.75 -4.20 0.0342 0 0 0</pose></include>
    <include><name>ped_west</name>  <uri>model://amr_pedestrian</uri><pose>-3.60  4.20 0.0342 0 0 0</pose></include>
    <include><name>ped_north</name> <uri>model://amr_pedestrian</uri><pose> 0.95  4.20 0.0342 0 0 0</pose></include>
    <include><name>cart_hall</name> <uri>model://amr_cart</uri>      <pose>-3.40 -7.60 0.0342 0 0 0</pose></include>

  </world>
</sdf>
