<?xml version="1.0"?>
<!-- Pedestrian: kinematic (moved by moving_obstacles.py, never pushed by physics). -->
<sdf version="1.6">
  <model name="amr_pedestrian">
    <static>false</static>
    <link name="body">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <collision name="collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>1.7</length></cylinder></geometry>
      </collision>
      <visual name="legs">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.15 0.2 0.45 1</ambient><diffuse>0.15 0.2 0.45 1</diffuse></material>
      </visual>
      <visual name="vest">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>1 0.45 0 1</ambient><diffuse>1 0.45 0 1</diffuse></material>
      </visual>
      <visual name="head">
        <pose>0 0 1.62 0 0 0</pose>
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material><ambient>0.85 0.65 0.5 1</ambient><diffuse>0.85 0.65 0.5 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
