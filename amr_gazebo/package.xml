<?xml version="1.0"?>
<package format="3">
  <name>amr_gazebo</name>
  <version>0.1.0</version>
  <description>AWS small warehouse + mezzanine/ramp + moving obstacles for the AMR fleet (Gazebo Classic)</description>
  <maintainer email="souravsharma1321@gmail.com">Sourav</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_bsp</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Tells gazebo_ros where our model:// folders are (${prefix} = share/amr_gazebo) -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
